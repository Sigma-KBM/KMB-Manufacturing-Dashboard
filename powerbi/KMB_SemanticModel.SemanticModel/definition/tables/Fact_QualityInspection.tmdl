	partition Fact_QualityInspection = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(pSourceFile), null, true),
				    Fact_QualityInspection = Source{[Item = "Fact_QualityInspection", Kind = "Table"]}[Data],
				    #"Changed Type" = Table.TransformColumnTypes(
				        Fact_QualityInspection,
				        {
				            {"InspectionKey", Int64.Type},
				            {"ProductionEventKey", Int64.Type},
				            {"DateKey", Int64.Type},
				            {"ProductKey", Int64.Type},
				            {"WorkCenterKey", Int64.Type},
				            {"DefectKey", Int64.Type},
				            {"InspectedQty", Int64.Type},
				            {"DefectQty", Int64.Type},
				            {"InspectionResult", type text},
				            {"DataSource", type text}
				        }
				    )
				in
				    #"Changed Type"

