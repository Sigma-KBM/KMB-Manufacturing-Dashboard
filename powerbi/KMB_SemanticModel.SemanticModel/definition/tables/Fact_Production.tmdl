	partition Fact_Production = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(pSourceFile), null, true),
				    Fact_Production = Source{[Item = "Fact_Production", Kind = "Table"]}[Data],
				    #"Changed Type" = Table.TransformColumnTypes(
				        Fact_Production,
				        {
				            {"ProductionEventKey", Int64.Type},
				            {"DateKey", Int64.Type},
				            {"ProductKey", Int64.Type},
				            {"WorkCenterKey", Int64.Type},
				            {"Shift", type text},
				            {"PlannedQty", Int64.Type},
				            {"ProducedQty", Int64.Type},
				            {"GoodQty", Int64.Type},
				            {"ScrapQty", Int64.Type},
				            {"ReworkQty", Int64.Type},
				            {"LaborHours", type number},
				            {"DowntimeMinutes", Int64.Type},
				            {"ProductionValue", type number},
				            {"PlannedCompletionDateTime", type datetime},
				            {"ActualCompletionDateTime", type datetime},
				            {"DataSource", type text}
				        }
				    )
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

