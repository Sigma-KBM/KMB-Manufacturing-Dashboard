table Fact_Production
	lineageTag: 82df6053-0a8f-40ab-9762-edee4d5fb941

	measure 'Planned Quantity' =
			
			SUM ( Fact_Production[PlannedQty] )
		formatString: #,0
		lineageTag: bec03730-9d1a-4352-917c-caec7193d90f

	measure 'Produced Quantity' =
			
			SUM ( Fact_Production[ProducedQty] )
		formatString: #,0
		lineageTag: 063bab9f-f6dd-49a2-9239-93a8c765ff58

	measure 'Good Quantity' =
			
			SUM ( Fact_Production[GoodQty] )
		formatString: #,0
		lineageTag: 454686a0-2a50-4a80-997d-5c5748058f20

	measure 'Scrap Quantity' =
			
			SUM ( Fact_Production[ScrapQty] )
		formatString: #,0
		lineageTag: 381678c6-0be3-4629-94e0-7b3cbb3aaa0a

	measure 'Rework Quantity' =
			
			SUM ( Fact_Production[ReworkQty] )
		formatString: #,0
		lineageTag: eb9d3b74-5083-4936-82b1-adf11c9fb730

	measure 'Production Attainment %' =
			
			DIVIDE ( [Produced Quantity], [Planned Quantity] )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: d3e51faa-83f5-4c2b-a608-fe600711928b

	measure 'First Pass Yield %' =
			
			DIVIDE ( [Good Quantity], [Produced Quantity] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 64173d93-626f-4b69-bb45-efb8e64dccb3

	measure 'Scrap Rate %' =
			
			DIVIDE ( [Scrap Quantity], [Produced Quantity] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 32014dac-12d8-4474-87fc-ce3d0ddfa68c

	measure 'Rework Rate %' =
			
			DIVIDE ( [Rework Quantity], [Produced Quantity] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 592e113a-1f29-4a27-833a-291b9d1ac6a9

	measure 'Production Value' =
			
			SUM ( Fact_Production[ProductionValue] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: d881c376-3583-4cf4-9c46-96d2ad21707b

	measure 'Downtime Minutes' =
			
			SUM ( Fact_Production[DowntimeMinutes] )
		formatString: #,0
		lineageTag: 6cd411a2-81da-4aa0-a6b9-8eae2162c358

	measure 'Production Labor Hours' =
			
			SUM ( Fact_Production[LaborHours] )
		formatString: 0.00
		lineageTag: 78288f84-ee26-43a5-a69d-bfd48fc524d5

	measure 'Available Production Minutes' =
			
			[Production Labor Hours] * 60
		formatString: #,0
		lineageTag: 3015ef98-7e82-4054-af2c-c806243a7e0b

	measure 'Operating Minutes' =
			
			[Available Production Minutes] - [Downtime Minutes]
		formatString: #,0
		lineageTag: e1684131-46dc-4365-8077-9262ae70afc7

	measure 'Availability Proxy %' =
			
			DIVIDE ( [Operating Minutes], [Available Production Minutes] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1739a6a9-72d5-4c3e-9654-8a292d6350a5

	measure 'Performance Proxy %' =
			
			DIVIDE (
			    SUMX (
			        Fact_Production,
			        Fact_Production[ProducedQty] * RELATED ( Dim_Product[StandardCycleMinutes] )
			    ),
			    [Operating Minutes]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: fd9d7b22-fa16-40da-9277-c0f900051e06

	measure 'OEE Proxy %' =
			
			[Availability Proxy %] * [Performance Proxy %] * [First Pass Yield %]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: bd5028ce-15c3-4ea5-8adf-b052008b7a14

	measure 'Scrap Value at Standard' =
			
			SUMX (
			    Fact_Production,
			    Fact_Production[ScrapQty] * RELATED ( Dim_Product[StandardUnitValue] )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 7859ee04-6b6b-4d9d-8e94-19b13315d665

	measure 'Rework Value at Standard' =
			
			SUMX (
			    Fact_Production,
			    Fact_Production[ReworkQty] * RELATED ( Dim_Product[StandardUnitValue] )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: ab499038-f0b8-4e4e-bf06-1378e2ce1a3f

	measure 'Quality Loss Value at Standard' =
			
			[Scrap Value at Standard] + [Rework Value at Standard]
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 94357f31-47d7-451a-a37e-23e44064266a

	measure 'On-Time Production %' =
			
			DIVIDE (
			    CALCULATE (
			        [Produced Quantity],
			        FILTER (
			            Fact_Production,
			            Fact_Production[ActualCompletionDateTime]
			                <= Fact_Production[PlannedCompletionDateTime]
			        )
			    ),
			    [Planned Quantity]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 09bcb843-e163-4bfb-8e03-9c3f7c077d53

	measure 'Scrap Cost' =
			
			SUMX (
			    Fact_Production,
			    Fact_Production[ScrapQty] * RELATED ( Dim_Product[StandardUnitCost] )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: a11eecdf-ab46-446b-8738-5ab730e6fff3

	measure 'Rework Cost' =
			
			SUMX (
			    Fact_Production,
			    Fact_Production[ReworkQty] * RELATED ( Dim_Product[StandardUnitCost] )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 92850f0e-f45a-4440-93bd-29106c96e660

	measure 'Cost of Poor Quality %' =
			
			DIVIDE (
			    [Scrap Cost] + [Rework Cost] + [MRB Material Cost],
			    [Production Value]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 94d751fe-597f-4d5b-9fed-c61ec2352dd3

	measure 'Quality Loss Quantity' =
			
			[Scrap Quantity] + [Rework Quantity]
		formatString: #,0
		lineageTag: 9061595e-4d9e-44ba-a047-559971bcb3f2

	measure 'Quality Loss Cell Color' =
			
			VAR CurrentLoss = [Quality Loss Quantity]
			VAR MatrixCells =
			    CROSSJOIN (
			        ALL ( Dim_WorkCenter[Line] ),
			        ALL ( Fact_Production[Shift] )
			    )
			VAR MatrixLosses =
			    ADDCOLUMNS (
			        MatrixCells,
			        "@QualityLoss", CALCULATE ( [Quality Loss Quantity] )
			    )
			VAR Position =
			    RANKX ( MatrixLosses, [@QualityLoss], CurrentLoss, ASC, DENSE )
			VAR CellCount = COUNTROWS ( MatrixLosses )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( CurrentLoss ), "#F1F5F9",
			        Position = 1, "#EAF7F1",
			        Position = CellCount, "#FDEDEE",
			        "#FFF7E6"
			    )
		lineageTag: e9a2d83b-3c59-4e77-944e-66ae4f979b67

	measure 'Production Variance' =
			
			[Produced Quantity] - [Planned Quantity]
		formatString: #,0;-#,0;#,0
		lineageTag: fced4784-d268-4c29-9ce4-251c1090fbdd

	measure 'Production Plan Status' =
			
			VAR Attainment = [Production Attainment %]
			RETURN
			    IF (
			        ISBLANK ( Attainment ),
			        "Not Available",
			        IF ( Attainment >= 1, "On Plan", "Below Plan" )
			    )
		lineageTag: c9d83f66-1ca5-4171-920a-1bd63775a4d4

	measure 'Production Plan Status Icon' =
			
			SWITCH ( [Production Plan Status], "On Plan", "✓", "Below Plan", "!", "—" )
		lineageTag: f890e4f7-e258-4bfb-8cb1-7b088d78d8eb

	measure 'Production Plan Status Color' =
			
			SWITCH (
			    [Production Plan Status],
			    "On Plan", "#218C74",
			    "Below Plan", "#D97706",
			    "#64748B"
			)
		lineageTag: b526e8dc-71e4-4091-a060-b9d408a740fd

	measure 'Production Plan Card Background Color' =
			
			SWITCH (
			    [Production Plan Status],
			    "On Plan", "#EAF7F1",
			    "Below Plan", "#FFF7E6",
			    "#F1F5F9"
			)
		lineageTag: 916a0b6f-a471-4a02-a244-303cf65d7ca2

	measure 'Production Plan Accent Bar' = 1
		formatString: 0
		lineageTag: 0831c4db-19e8-4caa-a8c6-7520713a49b1

	measure 'Operational Exception Flag' =
			
			IF ( [Production Variance] < 0, 1, 0 )
		formatString: 0
		lineageTag: 7b64ac5d-862f-4584-8c2d-ca700a98fa94

