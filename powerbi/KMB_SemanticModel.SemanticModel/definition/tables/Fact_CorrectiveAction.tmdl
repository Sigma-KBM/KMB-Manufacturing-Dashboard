				    Source = Excel.Workbook(File.Contents(pSourceFile), null, true),
				    Fact_CorrectiveAction = Source{[Item = "Fact_CorrectiveAction", Kind = "Table"]}[Data],
				    #"Changed Type" = Table.TransformColumnTypes(
				        Fact_CorrectiveAction,
