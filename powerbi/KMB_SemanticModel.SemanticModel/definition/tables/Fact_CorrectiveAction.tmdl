table Fact_CorrectiveAction
	lineageTag: ab4c9117-e7d9-4600-a591-3a0d676641b8

	measure 'Corrective Actions' =
			
			COUNTROWS ( Fact_CorrectiveAction )
		formatString: #,0
		lineageTag: 314a5e5d-a7ad-4031-96b7-aa6c18949815

	measure 'Open Corrective Actions' =
			CALCULATE (
			    [Corrective Actions],
			    Fact_CorrectiveAction[Status] = "Open",
			    REMOVEFILTERS ( Dim_Date )
			)
		formatString: #,0
		lineageTag: b32655af-8dfe-4faf-a557-a12137d7447f

	measure 'Corrective Action On-Time %' =
			VAR SelectedDates = VALUES ( Dim_Date[Date] )
			VAR ActionsInSelectedScope =
			    CALCULATETABLE (
			        Fact_CorrectiveAction,
			        REMOVEFILTERS ( Dim_Date )
			    )
			VAR ClosedActions =
			    FILTER (
			        ActionsInSelectedScope,
			        Fact_CorrectiveAction[Status] = "Closed"
			            && CONTAINS (
			                SelectedDates,
			                Dim_Date[Date],
			                Fact_CorrectiveAction[DueDate]
			            )
			    )
			VAR ClosedOnTime =
			    FILTER (
			        ClosedActions,
			        Fact_CorrectiveAction[CompletionDate] <= Fact_CorrectiveAction[DueDate]
			    )
			RETURN
			    DIVIDE ( COUNTROWS ( ClosedOnTime ), COUNTROWS ( ClosedActions ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2491dfac-7ebf-4af5-ab3b-b65138783485

	column ActionKey
		dataType: int64
		formatString: 0
		lineageTag: 02f66e4b-2690-4f12-8f38-0f799ac1ed7e
		summarizeBy: count
		sourceColumn: ActionKey

		annotation SummarizationSetBy = Automatic

