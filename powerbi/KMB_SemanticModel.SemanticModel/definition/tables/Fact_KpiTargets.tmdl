				        KPIName IN {
				            "On-Time Production %", "First Pass Yield %", "Scrap Rate %", "Rework Rate %",
				            "Cost of Poor Quality %", "OEE Proxy %", "Training On-Time %",
				            "Training Compliance %", "Corrective Action On-Time %",
				            "Target Attainment %", "Defect Recurrence Rate %"
				        }, "0.0%",
				        KPIName = "Defects per 1K Units", "0.0",
				        KPIName IN { "MRB Open Cases", "MRB Aging >30 Days" }, "#,0",
				        "0.0"
				    )

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tactical Weekly Direction' =
			VAR WeekDate = MAX ( Dim_Date[WeekStartDate] )
			VAR PeriodStart = DATE ( YEAR ( WeekDate ), MONTH ( WeekDate ), 1 )
			VAR KPISelection =
			    CALCULATE ( SELECTEDVALUE ( Fact_KpiTargets[KPIName] ), REMOVEFILTERS ( Dim_Date ) )
			RETURN
			    CALCULATE (
			        SELECTEDVALUE ( Fact_KpiTargets[Direction] ),
			        REMOVEFILTERS ( Dim_Date ),
			        REMOVEFILTERS ( Fact_KpiTargets ),
			        Fact_KpiTargets[KPIName] = KPISelection,
			        Fact_KpiTargets[PeriodStart] = PeriodStart,
			        Fact_KpiTargets[ScopeType] = "Enterprise",
			        Fact_KpiTargets[ScopeKey] = "KMB",
			        Fact_KpiTargets[IsActive] = TRUE ()
			    )
		lineageTag: 4500bbad-338d-4bc3-b665-e3c06ce167a9

	measure 'Tactical Weekly Red Tolerance %' =
			VAR WeekDate = MAX ( Dim_Date[WeekStartDate] )
			VAR PeriodStart = DATE ( YEAR ( WeekDate ), MONTH ( WeekDate ), 1 )
			VAR KPISelection =
			    CALCULATE ( SELECTEDVALUE ( Fact_KpiTargets[KPIName] ), REMOVEFILTERS ( Dim_Date ) )
			RETURN
			    CALCULATE (
			        MAX ( Fact_KpiTargets[RedTolerancePct] ),
			        REMOVEFILTERS ( Dim_Date ),
			        REMOVEFILTERS ( Fact_KpiTargets ),
			        Fact_KpiTargets[KPIName] = KPISelection,
			        Fact_KpiTargets[PeriodStart] = PeriodStart,
			        Fact_KpiTargets[ScopeType] = "Enterprise",
			        Fact_KpiTargets[ScopeKey] = "KMB",
			        Fact_KpiTargets[IsActive] = TRUE ()
			    )
		lineageTag: ccfb51cc-8df7-4010-b4bb-c56c504c3868

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tactical Weekly Target Display' =
			VAR KPIName =
			    CALCULATE ( SELECTEDVALUE ( Fact_KpiTargets[KPIName] ), REMOVEFILTERS ( Dim_Date ) )
			VAR TargetValue = [Tactical Weekly Target]
			VAR IsPercent =
			    KPIName IN {
			        "On-Time Production %", "First Pass Yield %", "Scrap Rate %", "Rework Rate %",
			        "Cost of Poor Quality %", "OEE Proxy %", "Training On-Time %",
			        "Training Compliance %", "Corrective Action On-Time %",
			        "Target Attainment %", "Defect Recurrence Rate %"
			    }
			RETURN
			    IF (
			        ISBLANK ( TargetValue ),
			        "—",
			        SWITCH (
			            TRUE (),
			            IsPercent, FORMAT ( TargetValue, "0.0%" ),
			            KPIName = "Defects per 1K Units", FORMAT ( TargetValue, "0.0" ),
			            KPIName IN { "MRB Open Cases", "MRB Aging >30 Days" }, FORMAT ( TargetValue, "#,0" ),
			            FORMAT ( TargetValue, "#,0.0" )
			        )
