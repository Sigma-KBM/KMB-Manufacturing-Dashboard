			        "Target Attainment %", "Defect Recurrence Rate %"
			    }
			RETURN
			    IF (
			        ISBLANK ( ActualValue ),
			        "—",
			        SWITCH (
			            TRUE (),
			            IsPercent, FORMAT ( ActualValue, "0.0%" ),
			            KPIName = "Defects per 1K Units", FORMAT ( ActualValue, "0.0" ),
			            KPIName IN { "MRB Open Cases", "MRB Aging >30 Days" }, FORMAT ( ActualValue, "#,0" ),
			            FORMAT ( ActualValue, "#,0.0" )
			        )
			    )
		lineageTag: 9e5dd69b-b9e7-48dc-bea4-e0b34ca72327

	measure 'Tactical Weekly Target' =
			VAR IsVisibleWeek = [Tactical Week in Selected Last 13]
			VAR WeekDate = MAX ( Dim_Date[WeekStartDate] )
			VAR PeriodStart = DATE ( YEAR ( WeekDate ), MONTH ( WeekDate ), 1 )
			VAR KPISelection =
			    CALCULATE ( SELECTEDVALUE ( Fact_KpiTargets[KPIName] ), REMOVEFILTERS ( Dim_Date ) )
			VAR TargetValue =
			    CALCULATE (
			        MAX ( Fact_KpiTargets[TargetValue] ),
			        REMOVEFILTERS ( Dim_Date ),
			        REMOVEFILTERS ( Fact_KpiTargets ),
			        Fact_KpiTargets[KPIName] = KPISelection,
			        Fact_KpiTargets[PeriodStart] = PeriodStart,
			        Fact_KpiTargets[ScopeType] = "Enterprise",
			        Fact_KpiTargets[ScopeKey] = "KMB",
			        Fact_KpiTargets[IsActive] = TRUE ()
			    )
			RETURN
			    IF ( IsVisibleWeek = 1, TargetValue )
		lineageTag: 3b55565c-a609-4e18-8a3f-0eda1ec48613

		formatStringDefinition =
				VAR KPIName =
				    CALCULATE ( SELECTEDVALUE ( Fact_KpiTargets[KPIName] ), REMOVEFILTERS ( Dim_Date ) )
				RETURN
