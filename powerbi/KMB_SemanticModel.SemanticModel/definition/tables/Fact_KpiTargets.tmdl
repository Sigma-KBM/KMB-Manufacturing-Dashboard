	measure 'Selected KPI Actual' =
			
			VAR SelectedKPIName =
			    SELECTEDVALUE ( Fact_KpiTargets[KPIName] )
			RETURN
			    SWITCH (
			        SelectedKPIName,
			        "On-Time Production %", [On-Time Production %],
			        "First Pass Yield %", [First Pass Yield %],
			        "Defects per 1K Units", [Defects per 1K Units],
			        "Scrap Rate %", [Scrap Rate %],
			        "Rework Rate %", [Rework Rate %],
			        "MRB Open Cases", [Advanced Open MRB Cases Current],
			        "MRB Aging >30 Days", [Advanced MRB Aging >30 Current],
			        "Cost of Poor Quality %", [Cost of Poor Quality %],
			        "OEE Proxy %", [OEE Proxy %],
			        "Training On-Time %", [Training On-Time %],
			        "Training Compliance %", [Training Compliance %],
			        "Corrective Action On-Time %", [Corrective Action On-Time %],
			        "Target Attainment %", [Target Attainment %],
			        "Defect Recurrence Rate %", [Defect Recurrence Rate %],
			        BLANK ()
			    )
		lineageTag: 8ea8d1ed-4614-4c7e-a0d5-596fcac011fb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'KPI Status Label' =
			
			VAR Actual = [Selected KPI Actual]
			VAR Target = [Selected KPI Target]
			VAR Direction = [Selected KPI Direction]
			VAR RedTolerance = [Selected KPI Red Tolerance %]
			RETURN
			    IF (
			        ISBLANK ( Actual ) || ISBLANK ( Target ) || ISBLANK ( Direction ),
			        "Not Available",
			        SWITCH (
			            Direction,
			            "HigherIsBetter", IF ( Actual >= Target, "On Target", IF ( Actual >= Target * ( 1 - RedTolerance ), "Watch", "Off Target" ) ),
			            "LowerIsBetter", IF ( Actual <= Target, "On Target", IF ( Actual <= Target * ( 1 + RedTolerance ), "Watch", "Off Target" ) ),
			            "Not Available"
			        )
			    )
		lineageTag: a9a52719-62b4-4bf9-bafa-6b3987c0b7ca

	measure 'KPI Status Icon' =
			
