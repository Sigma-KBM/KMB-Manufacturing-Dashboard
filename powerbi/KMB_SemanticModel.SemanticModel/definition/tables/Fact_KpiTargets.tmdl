	measure 'Tactical Weekly Status Label' =
			VAR ActualValue = [Tactical Weekly Actual]
			VAR TargetValue = [Tactical Weekly Target]
			VAR Direction = [Tactical Weekly Direction]
			VAR RedTolerance = [Tactical Weekly Red Tolerance %]
			RETURN
			    IF (
			        ISBLANK ( ActualValue ) || ISBLANK ( TargetValue ) || ISBLANK ( Direction ),
			        "Not Available",
			        SWITCH (
			            Direction,
			            "HigherIsBetter", IF ( ActualValue >= TargetValue, "On Target", IF ( ActualValue >= TargetValue * ( 1 - RedTolerance ), "Watch", "Off Target" ) ),
			            "LowerIsBetter", IF ( ActualValue <= TargetValue, "On Target", IF ( ActualValue <= TargetValue * ( 1 + RedTolerance ), "Watch", "Off Target" ) ),
			            "Not Available"
			        )
			    )
		lineageTag: ef42a9e9-23f6-4141-b1e1-c0ff7e35efe1

	measure 'Tactical Status Month 1 Label' =
			VAR SlotNumber = 1
			VAR SelectedMonths =
			    CALCULATETABLE ( VALUES ( Dim_Date[YearMonth] ), ALLSELECTED ( Dim_Date[YearMonth] ) )
			VAR LatestSix = TOPN ( 6, SelectedMonths, Dim_Date[YearMonth], DESC )
			VAR MonthKey =
			    IF (
			        COUNTROWS ( LatestSix ) >= SlotNumber,
			        MAXX ( TOPN ( SlotNumber, LatestSix, Dim_Date[YearMonth], ASC ), Dim_Date[YearMonth] )
			    )
			RETURN
			    IF (
			        ISBLANK ( MonthKey ),
			        BLANK (),
			        FORMAT ( DATE ( VALUE ( LEFT ( MonthKey, 4 ) ), VALUE ( RIGHT ( MonthKey, 2 ) ), 1 ), "MMM yy" )
			    )
		lineageTag: 3dc60176-d8dd-4310-a7c4-49c65e564010

	measure 'Tactical Status Month 1 Icon' =
			VAR SlotNumber = 1
			VAR SelectedMonths =
			    CALCULATETABLE ( VALUES ( Dim_Date[YearMonth] ), ALLSELECTED ( Dim_Date[YearMonth] ) )
			VAR LatestSix = TOPN ( 6, SelectedMonths, Dim_Date[YearMonth], DESC )
			VAR MonthKey =
			    IF (
			        COUNTROWS ( LatestSix ) >= SlotNumber,
			        MAXX ( TOPN ( SlotNumber, LatestSix, Dim_Date[YearMonth], ASC ), Dim_Date[YearMonth] )
			    )
			VAR StatusLabel =
			    IF (
			        ISBLANK ( MonthKey ),
			        BLANK (),
			        CALCULATE (
			            [Tactical Scorecard Status Label],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { MonthKey }, Dim_Date[YearMonth] )
			        )
			    )
			RETURN
			    SWITCH ( StatusLabel, "On Target", "✓", "Watch", "!", "Off Target", "×", BLANK () )
		lineageTag: 00149303-54c6-4b3f-b9f4-8535428d6bde

