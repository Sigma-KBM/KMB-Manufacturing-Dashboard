			VAR MonthKey =
			    IF (
			        COUNTROWS ( LatestSix ) >= SlotNumber,
			        MAXX ( TOPN ( SlotNumber, LatestSix, Dim_Date[YearMonth], ASC ), Dim_Date[YearMonth] )
			    )
			VAR StatusLabel =
			    IF (
			        ISBLANK ( MonthKey ),
			        BLANK (),
			        CALCULATE (
			            [Tactical Scorecard Status Label],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { MonthKey }, Dim_Date[YearMonth] )
			        )
			    )
			RETURN
			    SWITCH ( StatusLabel, "On Target", "✓", "Watch", "!", "Off Target", "×", BLANK () )
		lineageTag: d7f9d759-bea5-4412-bc75-022761d8895a

	measure 'Tactical Status Month 6 Color' =
			VAR SlotNumber = 6
			VAR SelectedMonths =
			    CALCULATETABLE ( VALUES ( Dim_Date[YearMonth] ), ALLSELECTED ( Dim_Date[YearMonth] ) )
			VAR LatestSix = TOPN ( 6, SelectedMonths, Dim_Date[YearMonth], DESC )
			VAR MonthKey =
			    IF (
			        COUNTROWS ( LatestSix ) >= SlotNumber,
			        MAXX ( TOPN ( SlotNumber, LatestSix, Dim_Date[YearMonth], ASC ), Dim_Date[YearMonth] )
			    )
			VAR StatusLabel =
			    IF (
			        ISBLANK ( MonthKey ),
			        BLANK (),
			        CALCULATE (
			            [Tactical Scorecard Status Label],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { MonthKey }, Dim_Date[YearMonth] )
			        )
			    )
			RETURN
			    SWITCH ( StatusLabel, "On Target", "#218C74", "Watch", "#D97706", "Off Target", "#C73E3A", "#64748B" )
		lineageTag: 4df4cc07-7b0d-4c3e-9161-eeca01813a53

