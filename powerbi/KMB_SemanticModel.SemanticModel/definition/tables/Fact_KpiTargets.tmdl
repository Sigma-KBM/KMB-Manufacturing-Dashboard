	measure 'Tactical Action Status Display' =
			
			VAR ActionStatus = SELECTEDVALUE ( Fact_CorrectiveAction[Status] )
			VAR DueDate = SELECTEDVALUE ( Fact_CorrectiveAction[DueDate] )
			VAR DataThroughDate = [Model Data-Through Date]
			RETURN
			    IF (
			        ISBLANK ( ActionStatus ),
			        "—",
			        IF (
			            ActionStatus = "Open" && NOT ISBLANK ( DueDate ) && NOT ISBLANK ( DataThroughDate ) && DueDate < DataThroughDate,
			            "Open · overdue",
			            ActionStatus
			        )
			    )
		lineageTag: d8ae416c-a9c1-42c5-b578-bddb51cd3001

	measure 'Target Attainment %' =
			VAR ContextDate = MAX ( Dim_Date[Date] )
			VAR TargetPeriod = DATE ( YEAR ( ContextDate ), MONTH ( ContextDate ), 1 )
			VAR KPISet =
			    DATATABLE (
			        "KPI", STRING,
			        {
			            { "On-Time Production %" },
			            { "First Pass Yield %" },
			            { "Defects per 1K Units" },
			            { "Scrap Rate %" },
			            { "Rework Rate %" },
			            { "MRB Open Cases" },
			            { "MRB Aging >30 Days" },
			            { "Cost of Poor Quality %" },
			            { "OEE Proxy %" },
			            { "Training On-Time %" },
			            { "Training Compliance %" },
			            { "Corrective Action On-Time %" },
			            { "Defect Recurrence Rate %" }
			        }
			    )
			VAR KPIEvaluation =
			    ADDCOLUMNS (
			        KPISet,
			        "__Actual",
			            VAR MetricName = [KPI]
			            RETURN
			                SWITCH (
			                    MetricName,
			                    "On-Time Production %", [On-Time Production %],
			                    "First Pass Yield %", [First Pass Yield %],
			                    "Defects per 1K Units", [Defects per 1K Units],
			                    "Scrap Rate %", [Scrap Rate %],
			                    "Rework Rate %", [Rework Rate %],
			                    "MRB Open Cases", [Open MRB Cases As Of Date],
			                    "MRB Aging >30 Days", [MRB Aging >30 Days As Of Date],
			                    "Cost of Poor Quality %", [Cost of Poor Quality %],
			                    "OEE Proxy %", [OEE Proxy %],
			                    "Training On-Time %", [Training On-Time %],
			                    "Training Compliance %", [Training Compliance %],
			                    "Corrective Action On-Time %", [Corrective Action On-Time %],
			                    "Defect Recurrence Rate %", [Defect Recurrence Rate %]
			                ),
			        "__Target",
			            VAR MetricName = [KPI]
			            RETURN
			                CALCULATE (
			                    MAX ( Fact_KpiTargets[TargetValue] ),
			                    REMOVEFILTERS ( Dim_Date ),
			                    REMOVEFILTERS ( Fact_KpiTargets ),
			                    Fact_KpiTargets[KPIName] = MetricName,
			                    Fact_KpiTargets[PeriodStart] = TargetPeriod,
			                    Fact_KpiTargets[ScopeType] = "Enterprise",
			                    Fact_KpiTargets[ScopeKey] = "KMB",
			                    Fact_KpiTargets[IsActive] = TRUE ()
			                ),
			        "__Direction",
			            VAR MetricName = [KPI]
			            RETURN
			                CALCULATE (
			                    SELECTEDVALUE ( Fact_KpiTargets[Direction] ),
			                    REMOVEFILTERS ( Dim_Date ),
			                    REMOVEFILTERS ( Fact_KpiTargets ),
			                    Fact_KpiTargets[KPIName] = MetricName,
			                    Fact_KpiTargets[PeriodStart] = TargetPeriod,
			                    Fact_KpiTargets[ScopeType] = "Enterprise",
			                    Fact_KpiTargets[ScopeKey] = "KMB",
			                    Fact_KpiTargets[IsActive] = TRUE ()
			                )
			    )
			VAR EvaluatedKPI =
			    FILTER (
			        KPIEvaluation,
			        NOT ISBLANK ( [__Actual] )
			            && NOT ISBLANK ( [__Target] )
			            && NOT ISBLANK ( [__Direction] )
			    )
			VAR KPIOnTarget =
			    FILTER (
			        EvaluatedKPI,
			        IF (
			            [__Direction] = "HigherIsBetter",
			            [__Actual] >= [__Target],
			            [__Actual] <= [__Target]
			        )
			    )
			RETURN
			    DIVIDE ( COUNTROWS ( KPIOnTarget ), COUNTROWS ( EvaluatedKPI ) )
		formatString: 0.0%
		lineageTag: 29d8f23b-9c64-4b08-91c3-6a330dc23f03

	measure 'Tactical Week in Selected Last 13' =
			VAR CurrentWeek = SELECTEDVALUE ( Dim_Date[WeekStartDate] )
			VAR SelectedCompleteWeeks =
			    CALCULATETABLE (
			        VALUES ( Dim_Date[WeekStartDate] ),
			        ALLSELECTED ( Dim_Date ),
			        Dim_Date[IsCompleteWeek] = TRUE ()
			    )
			VAR Last13Weeks =
			    TOPN ( 13, SelectedCompleteWeeks, Dim_Date[WeekStartDate], DESC )
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentWeek )
			            && CONTAINS ( Last13Weeks, Dim_Date[WeekStartDate], CurrentWeek ),
			        1
			    )
		formatString: 0
		lineageTag: 61cae8fc-08cf-4eb3-9fa4-3bb4a2a8f153

	measure 'Tactical Weekly Actual' =
			VAR IsVisibleWeek = [Tactical Week in Selected Last 13]
			VAR KPISelection =
			    CALCULATE ( SELECTEDVALUE ( Fact_KpiTargets[KPIName] ), REMOVEFILTERS ( Dim_Date ) )
			VAR ActualValue =
			    SWITCH (
			        KPISelection,
			        "On-Time Production %", [On-Time Production %],
			        "First Pass Yield %", [First Pass Yield %],
			        "Defects per 1K Units", [Defects per 1K Units],
			        "Scrap Rate %", [Scrap Rate %],
			        "Rework Rate %", [Rework Rate %],
			        "MRB Open Cases", [Open MRB Cases As Of Date],
			        "MRB Aging >30 Days", [MRB Aging >30 Days As Of Date],
			        "Cost of Poor Quality %", [Cost of Poor Quality %],
			        "OEE Proxy %", [OEE Proxy %],
			        "Training On-Time %", [Training On-Time %],
			        "Training Compliance %", [Training Compliance %],
			        "Corrective Action On-Time %", [Corrective Action On-Time %],
			        "Target Attainment %", [Target Attainment %],
			        "Defect Recurrence Rate %", [Defect Recurrence Rate %],
			        BLANK ()
			    )
			RETURN
			    IF ( IsVisibleWeek = 1, ActualValue )
		lineageTag: 436bc359-fdc8-4a69-976f-1197540cb107

		formatStringDefinition =
