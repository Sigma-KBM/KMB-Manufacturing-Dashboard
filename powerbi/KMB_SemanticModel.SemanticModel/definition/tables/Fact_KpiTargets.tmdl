	measure 'Tactical KPI Gap to Target' =
			
			VAR ActualValue = [Selected KPI Actual]
			VAR TargetValue = [Tactical Selected KPI Target]
			VAR Direction = [Tactical Selected KPI Direction]
			RETURN
			    IF (
			        ISBLANK ( ActualValue ) || ISBLANK ( TargetValue ) || ISBLANK ( Direction ),
			        BLANK (),
			        SWITCH (
			            Direction,
			            "HigherIsBetter", ActualValue - TargetValue,
			            "LowerIsBetter", TargetValue - ActualValue,
			            BLANK ()
			        )
			    )
