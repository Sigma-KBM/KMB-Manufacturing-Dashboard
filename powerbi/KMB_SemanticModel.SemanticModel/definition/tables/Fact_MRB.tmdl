table Fact_MRB
	lineageTag: c20a5db4-3970-4c35-b01d-ffd01a9d81eb

	measure 'MRB Cases' =
			
			COUNTROWS ( Fact_MRB )
		formatString: #,0
		lineageTag: d303e861-dc76-42c1-a482-ece07d6788a2

	measure 'Open MRB Cases' =
			
			CALCULATE ( [MRB Cases], Fact_MRB[Status] = "Open" )
		formatString: #,0
		lineageTag: e380eef6-7ddb-4275-a9bc-76af6e98b175

	measure 'MRB Material Cost' =
			
			SUM ( Fact_MRB[MaterialCost] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: b4b5670e-eec6-4077-8c41-7dbcff4c1778

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'MRB Closure Rate %' =
			
			DIVIDE (
			    CALCULATE ( [MRB Cases], Fact_MRB[Status] = "Closed" ),
			    [MRB Cases]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c8936c83-7b78-4685-9724-5eba336fad2c

	measure 'Model Data-Through Date' =
			
			CALCULATE ( MAX ( Dim_Date[Date] ), ALL ( Dim_Date ) )
		formatString: mmmm d\, yyyy
		lineageTag: 96084e26-48b2-4a0c-b796-381862517925

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure 'MRB Aging >30 Days' =
			
			VAR DataThroughDate = [Model Data-Through Date]
			RETURN
			    CALCULATE (
			        [MRB Cases],
			        Fact_MRB[Status] = "Open",
			        FILTER (
			            Fact_MRB,
			            DATEDIFF ( Fact_MRB[OpenDate], DataThroughDate, DAY ) > 30
			        )
			    )
		formatString: #,0
		lineageTag: 04436437-be39-4668-8e88-305ac7522fe5

	measure 'Closed MRB Cases' =
			
			CALCULATE ( [MRB Cases], Fact_MRB[Status] = "Closed" )
		formatString: #,0
		lineageTag: ca42b6b1-9b6f-424e-9106-ba117c3f3af4

	measure 'Advanced Open MRB Cases Current' = CALCULATE ( [Open MRB Cases], REMOVEFILTERS ( Dim_Date ) )
		formatString: #,0
		lineageTag: e6ddf2c4-62e7-4849-ac52-f17d7f7a656f

	measure 'Open MRB Cases As Of Date' =
			VAR AsOfDate = MAX ( Dim_Date[Date] )
			VAR MRBInSelectedScope =
			    CALCULATETABLE (
			        Fact_MRB,
			        REMOVEFILTERS ( Dim_Date )
			    )
			RETURN
			    IF (
			        ISBLANK ( AsOfDate ),
			        BLANK (),
			        COUNTROWS (
			            FILTER (
			                MRBInSelectedScope,
			                Fact_MRB[OpenDate] <= AsOfDate
			                    && ( ISBLANK ( Fact_MRB[CloseDate] ) || Fact_MRB[CloseDate] > AsOfDate )
			            )
			        )
			    )
		formatString: #,0
		lineageTag: a4e07f93-6ab7-49f5-8eac-14042792ff28

	measure 'MRB Aging >30 Days As Of Date' =
			VAR AsOfDate = MAX ( Dim_Date[Date] )
			VAR MRBInSelectedScope =
			    CALCULATETABLE (
			        Fact_MRB,
			        REMOVEFILTERS ( Dim_Date )
			    )
			RETURN
			    IF (
			        ISBLANK ( AsOfDate ),
			        BLANK (),
			        COUNTROWS (
			            FILTER (
			                MRBInSelectedScope,
			                Fact_MRB[OpenDate] <= AsOfDate - 30
			                    && ( ISBLANK ( Fact_MRB[CloseDate] ) || Fact_MRB[CloseDate] > AsOfDate )
			            )
			        )
			    )
		formatString: #,0
		lineageTag: 8a561b51-fb48-4a53-a696-a02508f7cf98

	measure 'Advanced MRB Aging >30 Current' = CALCULATE ( [MRB Aging >30 Days], REMOVEFILTERS ( Dim_Date ) )
		formatString: #,0
		lineageTag: f06ffda4-67d2-4864-ae87-0b3b7098226b

	measure 'Advanced Open MRB Context' =
			VAR AgingCases = [Advanced MRB Aging >30 Current]
			RETURN
			    IF ( ISBLANK ( AgingCases ), "Aging not available", FORMAT ( AgingCases, "#,0" ) & " older than 30 days" )
		lineageTag: ccaf49b0-2eb4-4ab3-9f72-41ca3c007e23

