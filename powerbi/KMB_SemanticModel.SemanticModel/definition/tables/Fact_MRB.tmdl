	partition Fact_MRB = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(pSourceFile), null, true),
				    Fact_MRB = Source{[Item = "Fact_MRB", Kind = "Table"]}[Data],
				    #"Changed Type" = Table.TransformColumnTypes(
				        Fact_MRB,
				        {
				            {"MRBCaseKey", Int64.Type},
				            {"DateKey", Int64.Type},
				            {"ProductKey", Int64.Type},
				            {"WorkCenterKey", Int64.Type},
				            {"SupplierKey", Int64.Type},
				            {"DefectKey", Int64.Type},
				            {"OpenDate", type date},
				            {"CloseDate", type date},
				            {"Quantity", Int64.Type},
				            {"MaterialCost", type number},
				            {"Disposition", type text},
				            {"Status", type text},
				            {"DataSource", type text}
				        }
				    )
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

