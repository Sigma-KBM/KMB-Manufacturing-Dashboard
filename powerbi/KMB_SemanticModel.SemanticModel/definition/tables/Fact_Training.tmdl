	partition Fact_Training = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(pSourceFile), null, true),
				    Fact_Training = Source{[Item = "Fact_Training", Kind = "Table"]}[Data],
				    #"Changed Type" = Table.TransformColumnTypes(
				        Fact_Training,
				        {
				            {"TrainingRecordKey", Int64.Type},
				            {"EmployeeKey", Int64.Type},
				            {"CourseName", type text},
				            {"AssignmentDate", type date},
