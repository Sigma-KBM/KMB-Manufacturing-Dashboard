table Fact_Training
	lineageTag: 1f7a2478-7306-49b3-99b3-8b104ad0ace3

	measure 'Training Assignments' =
			
			COUNTROWS ( Fact_Training )
		formatString: #,0
		lineageTag: c2ee5f9d-101a-45f4-b616-09fef36ec822

	measure 'Completed Training' =
			VAR SelectedDates = VALUES ( Dim_Date[Date] )
			RETURN
			    CALCULATE (
			        [Training Assignments],
			        Fact_Training[Status] = "Completed",
			        TREATAS ( SelectedDates, Fact_Training[DueDate] )
			    )
		formatString: #,0
		lineageTag: 137f7702-a4e7-4f16-b9e3-f0d5283c5d38

	measure 'Training Compliance %' =
			VAR SelectedDates = VALUES ( Dim_Date[Date] )
			VAR DueAssignments =
			    CALCULATE (
			        [Training Assignments],
			        TREATAS ( SelectedDates, Fact_Training[DueDate] )
			    )
			RETURN
			    DIVIDE ( [Completed Training], DueAssignments )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 89611493-f7f4-439d-854c-8f0ca6249d2d

	measure 'Training On-Time %' =
			VAR SelectedDates = VALUES ( Dim_Date[Date] )
			VAR CompletedOnTime =
			    CALCULATE (
			        [Training Assignments],
			        Fact_Training[Status] = "Completed",
			        TREATAS ( SelectedDates, Fact_Training[DueDate] ),
			        FILTER (
			            Fact_Training,
			            Fact_Training[CompletionDate] <= Fact_Training[DueDate]
			        )
			    )
			RETURN
			    DIVIDE ( CompletedOnTime, [Completed Training] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2a844848-fe95-4d03-af1f-bff69d9facb2

	column TrainingRecordKey
		dataType: int64
